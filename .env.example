# 環境変数の見本（Vite はこのファイルを読まない・運用者向け）
# 本番は Cloudflare → Workers & Pages → <Worker 名> → Settings → Build → Variables and secrets に置く
# Runtime タブには何も置かない（パターン B 直叩き）

# 本番オリジン（末尾スラッシュなし）。canonical・OGP・sitemap に使う
VITE_SITE_URL=https://<本番ドメイン>
# 1 = 検索エンジンに公開（index / sitemap / robots Allow）、0 または未設定 = ドラフト（noindex）
VITE_SITE_PUBLIC=1
# OGP 画像（未設定なら /og-image.png）
VITE_OG_IMAGE_URL=

# UpNote 公開 API（パターン B 直叩き・セット 1）。/api/v1 は含めない
VITE_UPNOTE_API_BASE_URL=https://api.upnote.jp
VITE_UPNOTE_PUBLIC_API_KEY=up_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_UPNOTE_API_KEY_HEADER=X-API-Key

# GA4 測定 ID（未設定ならアクセス解析タグを読み込まない）
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Search Console の所有権確認（HTML タグ方式の content 値・任意）
VITE_GOOGLE_SITE_VERIFICATION=
